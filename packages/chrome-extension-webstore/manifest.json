{
  "manifest_version": 3,
  "name": "HTML.to.Figma — Perfect Capture",
  "version": "1.0.2",
  "description": "Capture any webpage and convert it into fully editable native Figma layers.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "clipboardWrite",
    "storage"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "HTML.to.Figma — Perfect Capture"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "capture.js",
        "inject_preserve_buffer.js",
        "opentype.min.js",
        "potrace.min.js",
        "woff2.min.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
